{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Next.js: debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "runtimeArgs": [
        "--load-extension=${workspaceFolder}/chrome_ext/dist",
        // "--auto-open-devtools-for-tabs"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/chrome_ext/dist",
        "${workspaceFolder}/",
        "!/node_modules/**" // https://stackoverflow.com/questions/65237645/could-not-read-source-map-errors-when-connecting-to-node-debugger-next-js
      ]
      // "webRoot": "${workspaceFolder}",
    },
    {
      "name": "Next.js: debug full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}